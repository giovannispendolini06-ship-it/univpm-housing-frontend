# .env.local (NON committare mai questo file con i valori reali)

# --- OpenAI --------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opzionale: sovrascrive il modello di default (vedi lib/openai.ts)
OPENAI_MODEL=gpt-5.5

# --- Supabase ------------------------------------------------------------
# URL e anon key: sicuri da esporre al client (rispettano RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key: SOLO lato server, bypassa la RLS.
# Non prefissarla mai con NEXT_PUBLIC_, non esporla nel bundle client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- WhatsApp (pubblico: FAB fluttuante, /proprietari, fallback pagamenti) --
# Numero internazionale, es. +393331234567
# Temporaneo: numero personale fondatore; in futuro WhatsApp Business società.
NEXT_PUBLIC_WHATSAPP_NUMBER=+39xxxxxxxxxx

# --- Resend (email transazionali) ----------------------------------------
RESEND_API_KEY=re_xxxxxxxx
# Opzionale: override mittente (default in lib/email.ts = info@coabito.it)
# RESEND_FROM=Coabito <info@coabito.it>

# --- Cron (Vercel Cron → Authorization: Bearer $CRON_SECRET) -------------
CRON_SECRET=generate-a-long-random-string

# --- Waitlist nurture (giorni dopo confirmed_at; default 3 e 10) ----------
# WAITLIST_NURTURE_DELAY_DAYS_1=3
# WAITLIST_NURTURE_DELAY_DAYS_2=10

# --- Stripe (pagamenti affitto — placeholder finché la società non è pronta) --
# Lascia "test_pending" finché non hai chiavi reali (test o live).
# Con questi valori il checkout resta disattivato e mostra il fallback WhatsApp.
STRIPE_SECRET_KEY=test_pending
STRIPE_PUBLISHABLE_KEY=test_pending
# Preferibile lato client (opzionale; se assente si usa STRIPE_PUBLISHABLE_KEY server-side solo per il check)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=test_pending
# Webhook signing secret (Dashboard Stripe → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=test_pending

# --- Site URL (sitemap, email CTA, Stripe success/cancel) ----------------
NEXT_PUBLIC_SITE_URL=https://coabito.it
