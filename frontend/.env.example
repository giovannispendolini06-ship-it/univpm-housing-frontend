# .env.local (NON committare mai questo file con i valori reali)

# --- OpenAI --------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opzionale: sovrascrive il modello di default (vedi lib/openai.ts)
OPENAI_MODEL=gpt-5.5

# --- Supabase ------------------------------------------------------------
# URL e anon key: sicuri da esporre al client (rispettano RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key: OBBLIGATORIA lato server (API auth, waitlist, matching).
# Bypassa la RLS. NON prefissarla mai con NEXT_PUBLIC_, non esporla al client.
# Usata da: /api/auth/signup, /api/auth/reset-password/*, createServiceSupabaseClient
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- WhatsApp (pubblico: FAB fluttuante, /proprietari, fallback pagamenti) --
# Formato consigliato — internazionale SENZA + né spazi:
#   NEXT_PUBLIC_WHATSAPP_NUMBER=393758222238
# Non mettere un 39 extra se il valore lo include già (altrimenti wa.me
# punta a un numero inesistente tipo 3939375…).
# Accettati anche: +393758222238, 3758222238, 03758222238
# Temporaneo: numero personale fondatore; in futuro WhatsApp Business società.
NEXT_PUBLIC_WHATSAPP_NUMBER=393758222238

# Nome agente nei template WhatsApp outbound (admin CRM). Default: Giovanni
# NEXT_PUBLIC_AGENT_NAME=Giovanni

# --- CRM commerciale -------------------------------------------------------
# Base URL già coperto da NEXT_PUBLIC_SITE_URL
# RESEND_API_KEY / RESEND_FROM: usati anche per email outreach CRM
# Opzionale: tetto email automatiche (cron futuro)
# CRM_EMAIL_MAX_PER_HOUR=30
# CRM_EMAIL_MAX_PER_DAY=200

# --- Resend (100% delle email transazionali dell'APP) --------------------
# Waitlist, pagamenti, auth reset — tutto via Resend, NON via SMTP Auth Supabase.
RESEND_API_KEY=re_xxxxxxxx
# Opzionale: override mittente (default = Coabito <info@coabito.it>)
# RESEND_FROM=Coabito <info@coabito.it>
#
# Auth (identità/sessioni = Supabase; email = solo Resend):
#   POST /api/auth/signup              → admin.createUser + session cookies
#   POST /api/auth/reset-password/request → generateLink + sendPasswordResetEmail
#   POST /api/auth/reset-password/confirm → verifyOtp + update password
#   lib/auth-emails.ts
#
# Dashboard (manuale, una tantum):
#   Authentication → Providers/Emails → disattiva "Confirm email"
#   (mailer_autoconfirm = true). Abbandona SMTP Auth nativo — non ripararlo.

# --- Cron (Vercel Cron → Authorization: Bearer $CRON_SECRET) -------------
CRON_SECRET=generate-a-long-random-string

# --- Waitlist nurture (giorni dopo confirmed_at; default 3 e 10) ----------
# WAITLIST_NURTURE_DELAY_DAYS_1=3
# WAITLIST_NURTURE_DELAY_DAYS_2=10

# --- Stripe (pagamenti affitto — placeholder finché la società non è pronta) --
# Lascia "test_pending" finché non hai chiavi reali (test o live).
# Con questi valori il checkout resta disattivato e mostra il fallback WhatsApp.
STRIPE_SECRET_KEY=test_pending
STRIPE_PUBLISHABLE_KEY=test_pending
# Preferibile lato client (opzionale; se assente si usa STRIPE_PUBLISHABLE_KEY server-side solo per il check)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=test_pending
# Webhook signing secret (Dashboard Stripe → Developers → Webhooks)
STRIPE_WEBHOOK_SECRET=test_pending

# --- Site URL (sitemap, email CTA, Stripe success/cancel) ----------------
NEXT_PUBLIC_SITE_URL=https://coabito.it

# --- Launch countdown (homepage / lista d'attesa) — YYYY-MM-DD -----------
# Default in codice: 2026-09-01 (inizio AA / prime stanze)
# NEXT_PUBLIC_LAUNCH_DATE=2026-09-01

# --- Mapbox (mappa interattiva /stanze) ----------------------------------
# Token pubblico (pk.…). Senza token: fallback UI, elenco resta disponibile.
# Dashboard Mapbox → Tokens. Abilita URL coabito.it / localhost.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxx
